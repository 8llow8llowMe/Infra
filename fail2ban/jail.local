[DEFAULT]
# 기본 차단 시간: 1일 (필요시 더 길게 설정)
bantime  = 86400      ; # 24h
findtime = 600        ; # 10분 기준(필터별로 override 가능)
maxretry = 3          ; # 기본 허용 시도 횟수 (필터별 override 가능)
backend  = auto

# 안전목록 — 내부 IP, 모니터링/헬스체크, 클라우드 서비스 등은 여기 추가
# 예: ignoreip = 127.0.0.1/8 192.168.0.0/16 203.0.113.5
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = false

[sshd-ddos]
enabled = false

# 1) 악성 User-Agent 차단 — UA 패턴만 나오면 즉시 차단
[nginx-badbots]
enabled  = true
port     = http,https
filter   = nginx-badbots
logpath  = /var/log/nginx/access.log
maxretry = 1            ; # 1회만 탐지되어도 차단
findtime = 600          ; # 10분 이내
bantime  = 604800       ; # 7일(영구차단 전 임시값) — 필요시 더 길게

# 2) 존재하지 않는 스크립트/확장자 요청 차단 — 대부분 자동 스캔(봇)이므로 빠르게 차단
[nginx-noscript]
enabled  = true
port     = http,https
filter   = nginx-noscript
logpath  = /var/log/nginx/access.log
maxretry = 1            ; # 1회 차단
findtime = 300          ; # 5분 내
bantime  = 604800       ; # 7일

# 3) 경로 스캐닝(404/403 과다 발생) — API 서비스라면 지나치게 낮춘다간 문제
[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 8            ; # 8회 이상(짧은 기간에 반복되면 차단)
findtime = 300          ; # 5분 내
bantime  = 86400        ; # 24시간 차단
