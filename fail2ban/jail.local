[DEFAULT]
# 기본 설정 (로그 및 공통값)
loglevel = INFO
logtarget = /var/log/fail2ban.log  ; 파일에 기록 (entrypoint가 stdout 복제)
syslogsocket = auto

bantime  = 86400      ; # 24시간 차단 (필요시 서비스 성격에 맞게 조정)
findtime = 600        ; # 10분 이내 시도 기준
maxretry = 3          ; # 기본 허용 횟수
backend  = auto

# 내부망 / 허용 IP 화이트리스트
ignoreip = 127.0.0.1/8 ::1 192.168.0.0/16 10.0.0.0/8 1.235.23.72

# 필터별 규칙 정의

# 1️. 악성 User-Agent 기반 봇 (즉시 차단)
[nginx-badbots]
enabled  = true
port     = http,https
filter   = nginx-badbots
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800   ; # 7일

# 2. 스크립트/확장자 요청 (.php, .asp 등)
[nginx-noscript]
enabled  = true
filter   = nginx-noscript
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800

# 3. 관리자/워드프레스 경로 스캔 탐지
[nginx-botsearch]
enabled  = true
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800

# 4. 짧은 시간 내 에러 폭주 감지
[nginx-errburst]
enabled  = true
filter   = nginx-errburst
logpath  = /var/log/nginx/access.log
maxretry = 15
findtime = 60
bantime  = 86400
