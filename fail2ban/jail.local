[DEFAULT]
# 기본 설정 (로그 및 공통값)
loglevel = INFO
logtarget = /var/log/fail2ban.log
syslogsocket = auto

# 기본 값(필요시 개별 jail에서 override)
bantime  = 604800    ; # 기본: 7일
findtime = 600       ; # 10분
maxretry = 3
backend  = auto

# 내부망 / 허용 IP 화이트리스트
ignoreip = 127.0.0.1/8 ::1 192.168.0.0/16 10.0.0.0/8 1.235.23.72

# 비활성화된 기본 jail (컨테이너 내 SSH 없음)
[sshd]
enabled = false

[sshd-ddos]
enabled = false

# 필터별 규칙 정의 (활성화된 Nginx 관련 Jail)

# Access.log 기반
# 1️. 악성 User-Agent 기반 봇 (즉시 차단)
[nginx-badbots]
enabled  = true
port     = http,https
filter   = nginx-badbots
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800   ; # 7일

# 2. 스크립트/확장자 요청 (.php, .asp 등)
[nginx-noscript]
enabled  = true
filter   = nginx-noscript
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800

# 3. 관리자/워드프레스 경로 스캔 탐지
[nginx-botsearch]
enabled  = true
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 1
findtime = 300
bantime  = 604800

# 4. 짧은 시간 내 에러 폭주 감지 (짧은 시간 다수 4xx)
[nginx-errburst]
enabled  = true
filter   = nginx-errburst
logpath  = /var/log/nginx/access.log
maxretry = 15
findtime = 60
bantime  = 86400

# Error.log 기반
# 5. .env 시도 (가장 위험한 시도 — 즉시 밴)
[nginx-envscan]
enabled  = true
filter   = nginx-envscan
port     = http,https
logpath  = /var/log/nginx/error.log
maxretry = 1
findtime = 60
bantime  = 604800

# 6. error log - 일반적인 파일 not found / open failed 패턴 (경로 스캐너)
[nginx-errorpaths]
enabled  = true
filter   = nginx-errorpaths
logpath  = /var/log/nginx/error.log
maxretry = 2
findtime = 60
bantime  = 604800