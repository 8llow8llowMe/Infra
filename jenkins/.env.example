# Jenkins controller 설정
JENKINS_WEB_PORT=49999
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://jenkins-controller:8080
JENKINS_CONTROLLER_JAVA_OPTS=-Xms512m -Xmx2048m
JENKINS_OPTS=

# 미니PC builder agent 설정
# Jenkins UI에서 node를 먼저 만든 뒤 발급된 secret을 입력합니다.
JENKINS_BUILDER_NAME=minipc-builder
JENKINS_BUILDER_SECRET=change-me-after-node-created

# 원격 deploy agent 설정 예시
# backend-1 같은 배포 대상 서버에서 docker-compose-jenkins-agent.yml 실행 시 사용합니다.
JENKINS_DEPLOY_AGENT_NAME=backend-1-deploy
JENKINS_DEPLOY_AGENT_SECRET=change-me-after-node-created
