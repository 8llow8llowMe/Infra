KAFKA_PROJECT_NAME=kafka

# 공식 Apache Kafka 이미지 (amd64 / arm64 멀티아치).
# bitnami/kafka 공개 카탈로그는 2025년부터 갱신이 동결되어 공식 이미지로 이전했다.
# 이미지를 바꾸면 환경변수 접두어(KAFKA_CFG_* -> KAFKA_*)와 경로(/opt/kafka)가 함께 달라진다.
KAFKA_IMAGE=apache/kafka:4.3.1

# KRaft 클러스터 식별자. 3노드가 같은 값을 쓰고, 한 번 포맷하면 바꿀 수 없다.
# 새 클러스터를 만들 때는 반드시 새로 생성해서 넣는다.
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# 노드별 외부(advertised) 포트. 내부 리스너(9092)/컨트롤러(9093)는 컨테이너 내부 고정이다.
KAFKA_1_EXTERNAL_PORT=19092
KAFKA_2_EXTERNAL_PORT=29092
KAFKA_3_EXTERNAL_PORT=39092
# 외부 클라이언트가 바라볼 호스트 IP 또는 DNS (다른 서버에서 붙으면 반드시 실제 IP로)
KAFKA_EXTERNAL_HOST=localhost

# 노드별 데이터 디렉터리 (컨테이너의 /var/lib/kafka/data 에 마운트)
# 공식 이미지는 UID/GID 1000(appuser)으로 실행되므로 이 디렉터리 소유자가 1000:1000 이어야 한다.
KAFKA_1_DATA_DIR=./kafka-1-data
KAFKA_2_DATA_DIR=./kafka-2-data
KAFKA_3_DATA_DIR=./kafka-3-data

KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# 컨테이너 메모리 상한 (노드당, heap + page cache 여유 포함)
KAFKA_MEM_LIMIT=1g
KAFKA_UI_MEM_LIMIT=512m

KAFKA_NUM_PARTITIONS=3
# 3 브로커 기준: 복제 3, 최소 ISR 2 (1대 장애까지 쓰기 지속)
KAFKA_DEFAULT_REPLICATION_FACTOR=3
# acks=all 쓰기가 성공으로 인정되려면 필요한 복제본 수.
# 지정하지 않으면 Kafka 기본값이 1 이라, RF=3 이어도 복제본 1개만 살아 있을 때 쓰기가 성공해 유실 위험이 있다.
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_DELETE_TOPIC_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_MESSAGE_MAX_BYTES=10485760

# provectuslabs/kafka-ui 는 개발이 중단되어 유지보수 포크(kafbat)를 사용한다.
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
KAFKA_UI_CONTAINER_NAME=kafka-ui
KAFKA_UI_PORT=18080
TZ=Asia/Seoul
