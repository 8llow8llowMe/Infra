KAFKA_PROJECT_NAME=kafka
KAFKA_IMAGE=bitnami/kafka:3.9.0
KAFKA_CONTAINER_NAME=kafka
KAFKA_NODE_ID=1
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# 내부(Docker 네트워크) 리스너는 9092 고정이다. 변수로 바꾸지 않는다.
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=19092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# 컨테이너 메모리 상한 (heap + page cache 여유 포함)
KAFKA_MEM_LIMIT=1g
KAFKA_UI_MEM_LIMIT=512m
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_DELETE_TOPIC_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_MESSAGE_MAX_BYTES=10485760
KAFKA_DATA_DIR=./kafka-data
KAFKA_CONTAINER_DATA_DIR=/bitnami/kafka
# provectuslabs/kafka-ui 는 개발이 중단되어 유지보수 포크(kafbat)를 사용한다.
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.2.0
KAFKA_UI_CONTAINER_NAME=kafka-ui
KAFKA_UI_PORT=18080
TZ=Asia/Seoul
