# 애플리케이션 서버용 통합 agent 설정입니다.
# monitoring 루트에서 node_exporter와 Promtail을 함께 관리할 때 사용합니다.
TZ=Asia/Seoul

# 사용할 컨테이너 이미지
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
PROMTAIL_IMAGE=grafana/promtail:3.2.1

# 컨테이너 이름
NODE_EXPORTER_CONTAINER_NAME=node-exporter
PROMTAIL_CONTAINER_NAME=promtail

# node_exporter 호스트 노출 포트
NODE_EXPORTER_PORT=9100

# monitoring 서버의 Loki push URL
LOKI_PUSH_URL=http://192.168.0.14:3100/loki/api/v1/push

# Loki 로그에 붙일 라벨
PROMTAIL_HOSTNAME=backend-1
PROMTAIL_PROJECT=bosspickseoul
