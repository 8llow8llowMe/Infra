# Monitoring stack settings
TZ=Asia/Seoul

# Images
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana-oss:11.3.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2

# Container names
PROMETHEUS_CONTAINER_NAME=prometheus
GRAFANA_CONTAINER_NAME=grafana
NODE_EXPORTER_CONTAINER_NAME=node-exporter

# Host ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100

# Retention
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB

# Grafana admin account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password
GRAFANA_DOMAIN=grafana.8llow8llowme.com
GRAFANA_ROOT_URL=https://grafana.8llow8llowme.com/
