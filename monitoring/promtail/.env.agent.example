# 애플리케이션 서버용 Promtail agent 설정입니다.
# monitoring 서버가 아니라 "로그가 발생하는 서버"에서 사용합니다.
# Loki는 push 방식이라 원격 서버의 로그 파일을 스스로 읽어올 수 없습니다.
# 따라서 백엔드/프론트 서버마다 이 agent를 띄워 Loki로 밀어넣어야 합니다.
TZ=Asia/Seoul

# 사용할 컨테이너 이미지
PROMTAIL_IMAGE=grafana/promtail:3.2.1

# 컨테이너 이름
PROMTAIL_CONTAINER_NAME=promtail

# monitoring 서버의 Loki push URL
# 이 서버에서 monitoring 서버 3100 포트로 나가는 통신이 열려 있어야 합니다.
# Loki push API에는 인증이 없으므로 사설망 주소를 사용하고 공개망에 노출하지 않습니다.
LOKI_PUSH_URL=http://192.168.0.14:3100/loki/api/v1/push

# 로그가 발생한 서버를 구분하는 host 라벨입니다.
# 서버마다 다른 값을 넣어야 Grafana에서 어느 서버 로그인지 구분됩니다. (예: main-server, backend-1)
PROMTAIL_HOSTNAME=backend-1

# Grafana/Loki에서 필터링할 project 라벨입니다.
# 한 Loki에 여러 프로젝트 로그가 모이므로 프로젝트 구분에 사용합니다.
# 컨테이너에 observability.project 라벨이 있으면 그 값이 이 기본값을 덮어씁니다.
PROMTAIL_PROJECT=bosspickseoul
