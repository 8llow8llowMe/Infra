      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "min by (service_group, service) (up{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service_group}} / {{service}}"}],
