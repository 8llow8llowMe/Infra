{
  "id": null,
  "uid": "__PROJECT__-backend-overview",
  "title": "__PROJECT_TITLE__ 백엔드 개요",
  "tags": ["__PROJECT__", "backend", "docker", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
      {"name": "project", "label": "Project", "type": "constant", "query": "__PROJECT__", "hide": 2, "current": {"text": "__PROJECT__", "value": "__PROJECT__"}},
      {"name": "service_group", "label": "Group", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\"}, service_group)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", service_group=~\"$service_group\"}, env)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": false, "multi": false, "current": {}},
      {"name": "host", "label": "Host", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", env=~\"$env\"}, host)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", env=~\"$env\", host=~\"$host\"}, service)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "instance", "label": "Instance", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}, instance)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "서비스 상태 (UP / DOWN)", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "min by (env, service) (up{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{env}} / {{service}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP 요청 처리량", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service) (rate(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
