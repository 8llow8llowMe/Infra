{
  "id": null,
  "uid": "bosspickseoul-backend-overview",
  "title": "BossPickSeoul 백엔드 개요",
  "tags": ["bosspickseoul", "backend", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
      {"name": "project", "label": "Project", "type": "constant", "query": "bosspickseoul", "hide": 2, "current": {"text": "bosspickseoul", "value": "bosspickseoul"}},
      {"name": "service_group", "label": "Group", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\"}, service_group)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", service_group=~\"$service_group\"}, env)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": false, "multi": false, "sort": 1, "current": {}},
      {"name": "host", "label": "Host", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\"}, host)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\"}, service)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "instance", "label": "Instance", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(up{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}, instance)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "서비스 상태 (UP / DOWN)",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "min by (env, service) (up{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{env}} / {{service}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 요청 처리량",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service) (rate(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 응답시간",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{service}} p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 힙 사용률",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service) (jvm_memory_used_bytes{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx 오류율",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service) (rate(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", instance=~\"$instance\", status=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
