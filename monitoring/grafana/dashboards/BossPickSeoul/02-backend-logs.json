{
  "id": null,
  "uid": "bosspickseoul-backend-logs",
  "title": "BossPickSeoul 백엔드 로그",
  "tags": ["bosspickseoul", "backend", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "DS_LOKI", "label": "Loki", "type": "datasource", "query": "loki", "refresh": 1, "current": {}},
      {"name": "project", "label": "Project", "type": "constant", "query": "bosspickseoul", "hide": 2, "current": {"text": "bosspickseoul", "value": "bosspickseoul"}},
      {"name": "service_group", "label": "Group", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values({project=\"$project\"}, service_group)", "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values({project=\"$project\", service_group=~\"$service_group\"}, env)", "refresh": 1, "includeAll": false, "multi": false, "sort": 1, "current": {}},
      {"name": "host", "label": "Host", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\"}, host)", "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\"}, service)", "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "container", "label": "Container", "type": "query", "datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "query": "label_values({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}, container)", "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {}},
      {"name": "search", "label": "Search", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "서비스별 로그 수집량",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"refId": "A", "expr": "sum by (service) (count_over_time({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", container=~\"$container\"}[$__auto]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "경고 / 오류 로그",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [
        {"refId": "A", "expr": "sum by (service) (count_over_time({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", container=~\"$container\"} |~ \"(?i)error\" [$__auto]))", "legendFormat": "{{service}} ERROR"},
        {"refId": "B", "expr": "sum by (service) (count_over_time({project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", container=~\"$container\"} |~ \"(?i)warn\" [$__auto]))", "legendFormat": "{{service}} WARN"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 3,
      "type": "logs",
      "title": "서비스 로그",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"refId": "A", "expr": "{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", host=~\"$host\", service=~\"$service\", container=~\"$container\"} |~ \"(?i)$search\""}],
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}
    }
  ]
}
