{
  "id": null,
  "uid": "bosspickseoul-http-performance",
  "title": "BossPickSeoul HTTP 성능",
  "tags": ["bosspickseoul", "backend", "http", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
      {"name": "project", "type": "constant", "query": "bosspickseoul", "hide": 2, "current": {"text": "bosspickseoul", "value": "bosspickseoul"}},
      {"name": "service_group", "label": "Group", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(http_server_requests_seconds_count{project=\"$project\"}, service_group)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\"}, env)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": false, "multi": false, "current": {}},
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\"}, service)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "instance", "label": "Instance", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=~\"$env\", service=~\"$service\"}, instance)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "uri", "label": "URI", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(http_server_requests_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\", instance=~\"$instance\", uri!~\"/actuator.*\"}, uri)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "초당 요청 처리량", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, uri) (rate(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{service}} {{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 2, "type": "timeseries", "title": "p50 / p95 / p99 응답시간", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, service) (rate(http_server_requests_seconds_bucket{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{service}} p50"},
        {"refId": "B", "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{service}} p95"},
        {"refId": "C", "editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_requests_seconds_bucket{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{service}} p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 3, "type": "timeseries", "title": "HTTP 상태 코드 분포", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, status) (rate(http_server_requests_seconds_count{project=\"$project\", service_group=~\"$service_group\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{service}} {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
