{
  "id": null,
  "uid": "bosspickseoul-jpa-repository",
  "title": "BossPickSeoul JPA 리포지토리 성능",
  "tags": ["bosspickseoul", "backend", "jpa", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "description": "Spring Data 리포지토리 호출 메트릭을 조회합니다. 리포지토리 메서드가 한 번 이상 호출된 이후부터 데이터가 표시됩니다.",
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
      {"name": "project", "label": "Project", "type": "constant", "query": "bosspickseoul", "hide": 2, "current": {"text": "bosspickseoul", "value": "bosspickseoul"}},
      {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(spring_data_repository_invocations_seconds_count{project=\"$project\"}, env)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": false, "multi": false, "current": {}},
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\"}, service)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "repository", "label": "Repository", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\"}, repository)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}},
      {"name": "method", "label": "Method", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": {"query": "label_values(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\", repository=~\"$repository\"}, method)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {}}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "리포지토리 호출률",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, repository, method) (rate(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\", repository=~\"$repository\", method=~\"$method\"}[$__rate_interval]))", "legendFormat": "{{service}} / {{repository}}.{{method}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "리포지토리 평균 응답시간",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, repository, method) (rate(spring_data_repository_invocations_seconds_sum{project=\"$project\", env=~\"$env\", service=~\"$service\", repository=~\"$repository\", method=~\"$method\"}[$__rate_interval])) / clamp_min(sum by (service, repository, method) (rate(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\", repository=~\"$repository\", method=~\"$method\"}[$__rate_interval])), 0.001)", "legendFormat": "{{service}} / {{repository}}.{{method}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "리포지토리 오류",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, repository, method, exception) (rate(spring_data_repository_invocations_seconds_count{project=\"$project\", env=~\"$env\", service=~\"$service\", repository=~\"$repository\", method=~\"$method\", state=\"ERROR\"}[$__rate_interval]))", "legendFormat": "{{service}} / {{repository}}.{{method}} / {{exception}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
