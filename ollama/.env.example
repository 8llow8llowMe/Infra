# Ollama
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_ROCM_IMAGE=ollama/ollama:rocm
OLLAMA_CONTAINER_NAME=ollama
OLLAMA_PORT=11434
OLLAMA_CONTAINER_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
OLLAMA_DATA_DIR=./ollama-data
OLLAMA_CONTAINER_DATA_DIR=/root/.ollama

# Open WebUI
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPEN_WEBUI_CONTAINER_NAME=open-webui
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_CONTAINER_PORT=8080
OPEN_WEBUI_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_DATA_DIR=./open-webui-data
OPEN_WEBUI_CONTAINER_DATA_DIR=/app/backend/data
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# Optional AMD ROCm override for some Radeon 780M environments.
# Keep the default first; adjust only if the container falls back to CPU.
AMD_GPU_KFD_DEVICE=/dev/kfd
AMD_GPU_DRI_DEVICE=/dev/dri
AMD_GPU_GROUP=video
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Common
TZ=Asia/Seoul
